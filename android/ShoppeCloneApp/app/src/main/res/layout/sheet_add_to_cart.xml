<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/sheet_imgProduct"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_image_holder"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheet_txtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên sản phẩm"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827" />

            <TextView
                android:id="@+id/sheet_txtPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="512.000₫"
                android:textColor="#E11D48"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/sheet_txtStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kho: 100"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Số lượng"
        android:textColor="#374151"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_quantity_box"
        android:padding="4dp"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnMinus"
            android:src="@drawable/ic_minus"
            android:tint="#111827"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_quantity_btn"
            android:contentDescription="Giảm số lượng" />

        <TextView
            android:id="@+id/txtQuantity"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="1"
            android:textSize="18sp"
            android:textColor="#111827" />

        <ImageButton
            android:id="@+id/btnPlus"
            android:src="@drawable/ic_plus"
            android:tint="#111827"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_quantity_btn"
            android:contentDescription="Tăng số lượng" />
    </LinearLayout>

    <Button
        android:id="@+id/btnConfirmAdd"
        android:text="🛒  Thêm vào giỏ hàng"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_btn_gradient"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
