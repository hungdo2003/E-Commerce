<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp">

    <!-- avatar bot -->
    <ImageView
        android:id="@+id/imgBot"
        android:layout_width="36dp" android:layout_height="36dp"
        android:src="@android:drawable/ic_dialog_info"
        android:background="@drawable/bg_bubble_bot"
        android:padding="6dp"
        android:layout_marginEnd="6dp" />

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">

        <!-- TL;DR (ẩn/hiện tuỳ nội dung) -->
        <LinearLayout
            android:id="@+id/boxTldr"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_tldr"
            android:visibility="gone" android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvTldr"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#065F46" android:textSize="13sp"/>
        </LinearLayout>

        <!-- Bubble chính -->
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_bot"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvBotText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#111827"
                android:textSize="14sp"
                android:autoLink="web"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>

        <!-- (tuỳ chọn) khu vực hiển thị nguồn trích dẫn sau này -->
        <LinearLayout
            android:id="@+id/boxSources"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:orientation="vertical"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
