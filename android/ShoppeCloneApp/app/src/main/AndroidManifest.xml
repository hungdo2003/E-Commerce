<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.shoppeclone">

    <!-- 🌐 Quyền Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="ShoppeCloneApp"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShoppeClone"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- 🚀 Màn hình khởi động đầu tiên (LoginActivity) -->
        <activity
            android:name="com.example.shoppeclone.ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🏠 Màn hình chính sau khi đăng nhập -->
        <activity
            android:name="com.example.shoppeclone.ui.MainActivity"
            android:exported="false" />

        <!-- 💳 CheckoutActivity với Deep Link cho VNPay callback -->
        <activity
            android:name=".ui.CheckoutActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Xử lý custom scheme -->
                <data android:scheme="shoppeclone" android:host="vnpay-return" />
                <!-- Xử lý ngrok redirect -->
                <data android:scheme="https" android:host="moira-subjugular-anna.ngrok-free.dev"
                    android:pathPrefix="/api/VNPay/return" />
            </intent-filter>
        </activity>

        <!-- 🧩 Các activity phụ -->
        <activity
            android:name="com.example.shoppeclone.ui.ChatActivity"
            android:exported="false" />
        <activity
            android:name="com.example.shoppeclone.ui.CartActivity"
            android:exported="false" />
        <activity
            android:name="com.example.shoppeclone.ui.RegisterActivity"
            android:exported="false" />
        <activity android:name=".ui.ProductDetailActivity" android:exported="false" />
        <activity
            android:name=".ui.ChatTestActivity"
            android:exported="false" />
    </application>
</manifest>